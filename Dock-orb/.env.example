# ============================================================
# Capsule AI — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# ---- General ----
NODE_ENV=development

# ---- Database (PostgreSQL) ----
DATABASE_URL=postgresql://capsule:capsule_secret@localhost:5432/capsule_ai?schema=public
POSTGRES_USER=capsule
POSTGRES_PASSWORD=capsule_secret
POSTGRES_DB=capsule_ai

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- Qdrant (Vector DB) ----
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ---- LiteLLM Proxy ----
LITELLM_URL=http://localhost:4000
LITELLM_MASTER_KEY=sk-litellm-master-key

# ---- Auth ----
JWT_SECRET=change-this-to-a-random-64-char-string
JWT_REFRESH_SECRET=change-this-to-another-random-64-char-string
NEXTAUTH_SECRET=change-this-to-a-random-secret
NEXTAUTH_URL=http://localhost:3000

# ---- AI Provider API Keys ----
# Only configure the providers you want to use
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
NVIDIA_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=
OPENROUTER_API_KEY=

# ---- Ollama (local) ----
OLLAMA_BASE_URL=http://localhost:11434

# ---- LM Studio (local) ----
LMSTUDIO_BASE_URL=http://localhost:1234/v1

# ---- AI Services (Python FastAPI) ----
AI_SERVICES_URL=http://localhost:8000
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001

# ---- Cost Optimization ----
DEFAULT_TOKEN_BUDGET=4096
CACHE_TTL_SECONDS=3600
SEMANTIC_CACHE_THRESHOLD=0.92
CAPSULE_UPDATE_INTERVAL=5
