// ============================================================
// Capsule AI — Prisma Database Schema
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---- Users ----

model User {
  id            String            @id @default(cuid())
  email         String            @unique
  name          String?
  passwordHash  String?
  avatarUrl     String?
  preferences   Json              @default("{}")
  apiKeys       ApiKey[]
  workspaces    WorkspaceMember[]
  capsules      Capsule[]
  conversations Conversation[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@map("users")
}

// ---- Workspaces ----

model Workspace {
  id            String            @id @default(cuid())
  name          String
  description   String?
  settings      Json              @default("{}")
  members       WorkspaceMember[]
  capsules      Capsule[]
  conversations Conversation[]
  skills        WorkspaceSkill[]
  providers     ProviderConfig[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@map("workspaces")
}

model WorkspaceMember {
  id          String     @id @default(cuid())
  userId      String
  workspaceId String
  role        MemberRole @default(MEMBER)
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())

  @@unique([userId, workspaceId])
  @@map("workspace_members")
}

enum MemberRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

// ---- Capsule System ----

model Capsule {
  id            String            @id @default(cuid())
  workspaceId   String
  userId        String
  type          CapsuleType
  name          String
  description   String?
  content       Json
  metadata      Json              @default("{}")
  version       Int               @default(1)
  parentId      String?
  isActive      Boolean           @default(true)
  workspace     Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent        Capsule?          @relation("CapsuleHierarchy", fields: [parentId], references: [id])
  children      Capsule[]         @relation("CapsuleHierarchy")
  snapshots     CapsuleSnapshot[]
  conversations Conversation[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([workspaceId, type])
  @@index([userId])
  @@index([parentId])
  @@map("capsules")
}

enum CapsuleType {
  PROJECT
  USER
  TASK
  CONVERSATION
  TEAM
}

model CapsuleSnapshot {
  id        String   @id @default(cuid())
  capsuleId String
  version   Int
  content   Json
  changeLog String?
  capsule   Capsule  @relation(fields: [capsuleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([capsuleId, version])
  @@map("capsule_snapshots")
}

// ---- Conversations & Messages ----

model Conversation {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String
  capsuleId   String?
  title       String?
  summary     String?   @db.Text
  metadata    Json      @default("{}")
  messages    Message[]
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  capsule     Capsule?  @relation(fields: [capsuleId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([workspaceId])
  @@index([userId])
  @@index([capsuleId])
  @@map("conversations")
}

model Message {
  id             String      @id @default(cuid())
  conversationId String
  role           MessageRole
  content        String      @db.Text
  metadata       Json        @default("{}")
  tokensUsed     Int?
  cost           Float?
  modelUsed      String?
  providerUsed   String?
  skillsUsed     String[]
  cached         Boolean     @default(false)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdAt      DateTime    @default(now())

  @@index([conversationId])
  @@map("messages")
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
  TOOL
}

// ---- Provider Configuration ----

model ProviderConfig {
  id           String    @id @default(cuid())
  workspaceId  String
  provider     String
  displayName  String
  apiKeyEnc    String    @map("api_key_enc")
  baseUrl      String?
  models       Json      @default("[]")
  isEnabled    Boolean   @default(true)
  priority     Int       @default(0)
  routingRules Json      @default("{}")
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([workspaceId, provider])
  @@map("provider_configs")
}

// ---- Skills ----

model WorkspaceSkill {
  id          String    @id @default(cuid())
  workspaceId String
  skillPath   String
  isEnabled   Boolean   @default(true)
  config      Json      @default("{}")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([workspaceId, skillPath])
  @@map("workspace_skills")
}

// ---- Analytics ----

model UsageLog {
  id           String   @id @default(cuid())
  workspaceId  String
  userId       String
  provider     String
  model        String
  inputTokens  Int
  outputTokens Int
  totalTokens  Int
  cost         Float
  cached       Boolean  @default(false)
  responseTime Int
  skillsUsed   String[]
  intentType   String?
  createdAt    DateTime @default(now())

  @@index([workspaceId, createdAt])
  @@index([userId, createdAt])
  @@index([provider, createdAt])
  @@map("usage_logs")
}

// ---- API Keys ----

model ApiKey {
  id        String    @id @default(cuid())
  userId    String
  name      String
  keyHash   String    @unique
  prefix    String
  lastUsed  DateTime?
  expiresAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@map("api_keys")
}

// ---- Semantic Cache ----

model SemanticCache {
  id             String   @id @default(cuid())
  queryHash      String   @unique
  queryEmbedding String
  response       String   @db.Text
  metadata       Json     @default("{}")
  hitCount       Int      @default(0)
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  @@index([queryHash])
  @@index([expiresAt])
  @@map("semantic_cache")
}
